# ContentOS Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit actual secrets or credentials to git.

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL Database, Auth, Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# AI Providers (Modular & Pluggable)
# -----------------------------------------------------------------------------
AI_DEFAULT_PROVIDER="openai" # e.g., "openai" | "anthropic" | "gemini"

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""

# -----------------------------------------------------------------------------
# Media Providers (Voice & Visual Generation)
# -----------------------------------------------------------------------------
VOICE_PROVIDER="gemini" # "gemini" | "mock"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
VOICE_DEFAULT_NAME="Puck" # "Puck" | "Charon" | "Kore" | "Fenrir" | "Aoede"

IMAGE_PROVIDER="gemini" # "gemini" | "local" | "mock"

# Local Image Inference Server (ComfyUI / LocalAI / WebUI / Ollama compatible)
LOCAL_IMAGE_API_URL="http://127.0.0.1:8188"
LOCAL_IMAGE_MODEL="sdxl"
LOCAL_IMAGE_API_KEY="" # Optional authentication token for local proxy
LOCAL_IMAGE_TIMEOUT_MS="60000"


# -----------------------------------------------------------------------------
# Research Providers (Web Search & Extraction)
# -----------------------------------------------------------------------------
RESEARCH_PROVIDER="tavily" # "tavily" | "mock"
TAVILY_API_KEY="" # Server-only. Required when RESEARCH_PROVIDER="tavily"

# Research Constraints & Limits (Bounded Credit Control)
RESEARCH_MAX_QUESTIONS="3" # Max high-priority questions to research per brief (default: 3)
RESEARCH_MAX_SEARCHES_PER_QUESTION="1" # Max search queries per question (default: 1)
RESEARCH_MAX_EXTRACT_SOURCES="3" # Max URLs to extract full content from (default: 3)
RESEARCH_SEARCH_DEPTH="basic" # "basic" (1 credit) | "advanced" (2 credits)

# -----------------------------------------------------------------------------
# Background Jobs & Queue (Redis / BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Social Publishing Platforms (OAuth Credentials)
# -----------------------------------------------------------------------------
# YouTube / Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Meta / Instagram Graph API
META_APP_ID=""
META_APP_SECRET=""
INSTAGRAM_ACCOUNT_ID=""

# X (Twitter) API v2
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_REDIRECT_URI="http://localhost:3000/api/auth/callback/twitter"
